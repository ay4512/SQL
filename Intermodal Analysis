--I created a dataset in EXCEL with synthetic information based on my previous experience in logistics.--
--In this SQL analysis, I am looking into improving service performance, operation efficiency,--
--and profitability for this fictional logistics company.-- 

CREATE DATABASE LogisticsPortfolio;
--Reference--
SELECT*
FROM dbo.LogisticsDataset;

--Rail Line Performance--
--What rail line had the most issues with refused shipments?--
SELECT 
    RailLine,
    COUNT(*) AS TotalLoads,
	SUM(CASE WHEN ShipmentStatus = 'Delivered' THEN 1 
	ELSE 0 END) AS DeliveredLoads,
	SUM(CASE WHEN ShipmentStatus = 'Refused' THEN 1
	ELSE 0 END) AS RefusedLoads,
	CAST(100.0 * SUM(CASE WHEN ShipmentStatus = 'Refused' THEN 1 ELSE 0 END) / NULLIF(COUNT(*),0) AS DECIMAL(5,2)) AS RefusalPct
FROM dbo.LogisticsDataset
GROUP BY RailLine
ORDER BY RefusalPct DESC;

--What rail line had the most dwell days on their shipments?--
SELECT
    RailLine,
    COUNT(*) AS TotalShipments,
    SUM(RailDwell) AS TotalDwell,
    CAST(
        AVG(CAST(RailDwell AS DECIMAL(10,2))) AS DECIMAL(10,2)) AS AvgDwell,
    MIN(RailDwell) AS MinDwell,
    MAX(RailDwell) AS MaxDwell,
    SUM(CASE WHEN RailDwell = 0 THEN 1 ELSE 0 END) AS ZeroDwellDays,
    SUM(CASE WHEN MissedAppointment = 1 OR ShipmentStatus = 'Refused' THEN 1 ELSE 0 END) AS IssueShipments
FROM dbo.LogisticsDataset
GROUP BY RailLine
ORDER BY AvgDwell DESC;

--What rail line had the highest percentage of problem shipments?--
WITH RailLineIssues AS (
    SELECT 
        RailLine, 
        COUNT(*) AS TotalShipments,
        SUM(CASE WHEN MissedAppointment = 1 OR ShipmentStatus = 'Refused' THEN 1 ELSE 0 END) AS IssueShipments
    FROM dbo.LogisticsDataset
    GROUP BY RailLine
)
SELECT 
    RailLine, 
    TotalShipments, 
    IssueShipments,
    CAST(100.00 * IssueShipments / NULLIF(TotalShipments,0) AS DECIMAL (5,0)) AS IssueRatePct
FROM RailLineIssues
ORDER BY IssueRatePct DESC;

--What are the profit differences between rail lines?--
SELECT 
    RailLine,
    COUNT(*) AS TotalShipments,
    CAST(SUM(Revenue) / 1000 AS DECIMAL (10,2)) AS TotalRevenueByThous,
    CAST(SUM(TotalCost + StorageCharges) / 1000 AS DECIMAL (10,2)) AS TotalCostByThous,
    CAST(AVG(Revenue - TotalCost - StorageCharges) AS DECIMAL (10,2)) AS AvgProfit,
    CAST(SUM(Revenue - TotalCost - StorageCharges) / 1000 AS DECIMAL (10,2)) AS TotalProfitByThous
FROM dbo.LogisticsDataset
GROUP BY RailLine
ORDER BY TotalProfitByThous DESC;

--To conclude, the UP rail line appears to have the best performance with 0% refusal rate, relatively low dwell, fewer shipment issues, and strong total profitability.--
--The NS rail line should be investigated further due to its higher refusal rate on shipments to improve rail service reliability and reduce costs.--
--The CN Rail also has room for improvement. With the higher average dwell days and shipment issues, investigations need to focus on the causes of the delays to improve the rail performances.--

--Customer Profitability--
--What are the number of refused loads per customer?--
WITH RefusedShipments AS (
    SELECT
        Customer,
        COUNT(*) AS TotalShipments,
        SUM(CASE WHEN ShipmentStatus = 'Refused' THEN 1 ELSE 0 END) AS RefusedLoads
    FROM dbo.LogisticsDataset
    GROUP BY Customer
)
SELECT
    Customer,
    TotalShipments,
    RefusedLoads,
    CAST(100 * RefusedLoads / NULLIF(TotalShipments,0) AS DECIMAL(5,0)) AS RefusalRatePct
FROM RefusedShipments
ORDER BY RefusalRatePct DESC;
    
--What customers are making a profit and which are not?--
SELECT 
    Customer, 
    SUM(Revenue) / 1000 AS RevenueThous,
    SUM(TotalCost + StorageCharges) / 1000 AS CostThous,
    SUM(Revenue - TotalCost - StorageCharges) / 1000 AS ProfitThous
 FROM dbo.LogisticsDataset
 GROUP BY Customer
 ORDER BY ProfitThous ASC;

--What are the profit margins for the customers?--
SELECT 
    Customer,
    CAST (100 * SUM(Revenue - TotalCost - StorageCharges) 
        / NULLIF(SUM(Revenue), 0) AS DECIMAL (10,2)) AS ProfitMarginPct
FROM dbo.LogisticsDataset
GROUP BY Customer
ORDER BY ProfitMarginPct DESC;

--What are the average profit per shipment for each customer?--
SELECT
    Customer, 
    COUNT(*) AS TotalShipments,
    CAST(MAX(Revenue - TotalCost - StorageCharges) AS DECIMAL(10,0)) AS MaxProfit,
    CAST(MIN(Revenue - TotalCost - StorageCharges) AS DECIMAL(10,0)) AS MinProfit,
    CAST(AVG(Revenue - TotalCost - StorageCharges) AS DECIMAL(10,2)) AS ProfitAvg
FROM dbo.LogisticsDataset
GROUP BY Customer
ORDER BY ProfitAvg DESC;

--How much cost is associated with refused shipments?--
SELECT 
    Customer,
    SUM(CASE WHEN ShipmentStatus = 'Refused' THEN 1 ELSE 0 END) AS RefusedLoads,
    CAST(SUM(CASE WHEN ShipmentStatus = 'Refused' THEN TotalCost + StorageCharges ELSE 0 END)
        / 1000 AS DECIMAL (10,2)) AS RefusedCostsThous
FROM dbo.LogisticsDataset
GROUP BY Customer
ORDER BY RefusedCostsThous DESC;

--In conclusion, ABC HVAC appears to be the least profitable customer with approximately $24,000 in negative adjusted proit.--
--They also have negative profit margin showing that the total costs and storage charges are surpassing their revenue.--
--They also have the highest number of refused shipments and costs associated with those refusals.--
--Further investigation is recommended to identify their problems root causes and improve profitability and dissatisaction with the logistics company.--

--Route Performance--
--What routes have high costs relative to revenue?--
SELECT
    OriginRamp,
    DestinationRamp,
    COUNT(*) AS TotalShipments,
    CAST(SUM(Revenue) / 1000 AS DECIMAL (10,2)) AS TotalRevenueThous,
    CAST(SUM(TotalCost + StorageCharges) / 1000 AS DECIMAL (10,2)) AS TotalCostsThous,
    CAST(SUM(Revenue - TotalCost - StorageCharges) / 1000 AS DECIMAL (10,2)) AS TotalProfitThous,
    CAST(100 * SUM(TotalCost + StorageCharges)
        / NULLIF(SUM(Revenue),0) AS DECIMAL (10,2)) AS CostToRevenuePct
FROM dbo.LogisticsDataset
GROUP BY OriginRamp,DestinationRamp
ORDER BY CostToRevenuePct DESC;

--What exceptions are associated high storage costs?--
SELECT
    ExceptionType,
    COUNT(*) AS TotalExceptions,
    CAST(SUM(StorageCharges) AS DECIMAL (10,0)) AS TotalStorageCosts,
    CAST(AVG(StorageCharges) AS DECIMAL (10,0)) AS AvgStorageCosts
FROM dbo.LogisticsDataset
WHERE ExceptionType IS NOT NULL
GROUP BY ExceptionType
ORDER BY AvgStorageCosts DESC;

--What are the appointment completion rates by routes?--
WITH CompletionRate AS ( 
    SELECT
        OriginRamp,
        DestinationRamp, 
        COUNT(*) AS TotalShipments,
        SUM(CASE WHEN AppointmentStatus = 'Completed' THEN 1 ELSE 0 END) AS DeliveredLoads
    FROM dbo.LogisticsDataset
    GROUP BY OriginRamp, DestinationRamp)
SELECT 
    OriginRamp,
    DestinationRamp, 
    TotalShipments,
    DeliveredLoads,
    TotalShipments - DeliveredLoads AS PendingLoads,
    CAST(100.00 * DeliveredLoads / NULLIF(TotalShipments,0) AS DECIMAL(5,2)) AS CompletionPct
FROM CompletionRate
ORDER BY CompletionPct ASC;

--What routes have the most performance problems?
SELECT
    OriginRamp,
    DestinationRamp,
    COUNT(*) AS TotalShipments, 
    CAST(100.00 * SUM(CASE WHEN AppointmentStatus = 'Completed' THEN 1 ELSE 0 END) 
        / NULLIF(COUNT(*),0) AS DECIMAL (5,2)) AS CompletionRate,
    CAST(AVG(CAST(CustomerSatisfaction AS DECIMAL(5,2))) AS DECIMAL (5,2)) AS AvgRating,
    CAST(SUM(Revenue - TotalCost - StorageCharges) / 1000 AS DECIMAL (10,2)) AS TotalProfitThous,
    CAST(SUM(StorageCharges) / 1000 AS DECIMAL (10,2)) AS StorageCostThous
FROM dbo.LogisticsDataset
GROUP BY OriginRamp, DestinationRamp
ORDER BY TotalProfitThous ASC;

--Based on the dataset, Tacoma to Minneapolis and Houston to Memphis have the highest cost-to-revenue percentages.--
--These routes need to be look into to determine what exactly is affecting their profitability.--
--Nashville to Birmingham has a low appointment completion rate revealing potential reliability issues with deliveries.--
--Investigation needs to be done to see why shipmients are not being completed as scheduled.--
--Tacoma to Minneapolis also has low customer satisfaction and approximately $13,000 in negative profitability.--
--This needs to be priority to investigate with the issues associated with the route.--
--Investigations need to be done to find the underlying delays to improve route service and profitability.--

--Driver Performance-- 
--What drivers had the most issues with missed deliveries and redeliveries?--
WITH DriverIssues AS (
    SELECT
        DriverID,
        COUNT(*) AS TotalShipments,
        SUM(CAST(ReDelivery AS INT)) AS ReDeliveries,
        SUM(CAST(MissedAppointment AS INT)) AS Misses,
        SUM(CASE WHEN ReDelivery = 1 OR MissedAppointment = 1 THEN 1 ELSE 0 END) AS DeliveryIssues
    FROM dbo.LogisticsDataset
    GROUP BY DriverID)
SELECT
    DriverID,
    TotalShipments,
    ReDeliveries,
    Misses,
    DeliveryIssues,
    CAST(100.00 * DeliveryIssues / NULLIF(TotalShipments,0) AS DECIMAL (5,2)) AS IssuePctRate
FROM DriverIssues
ORDER BY IssuePctRate DESC;

--Which drivers have the most redelivery costs?
SELECT
    DriverID,
    COUNT(*) AS TotalShipments, 
    SUM(CAST(ReDelivery AS INT)) AS ReDeliveries,
    CAST(SUM(CASE WHEN ReDelivery = 1 THEN StorageCharges ELSE 0 END) AS DECIMAL (10,0)) AS ReDeliveryStorageCosts,
    CAST(AVG(CASE WHEN ReDelivery = 1 THEN StorageCharges END) AS DECIMAL (10,2)) AS AvgStorageCost
FROM dbo.LogisticsDataset
GROUP BY DriverID
ORDER BY ReDeliveryStorageCosts DESC;

--Which drivers have the lowest customer satisfaction ratings?--
SELECT
    DriverID,
    COUNT(*) AS TotalShipments,
    CAST(AVG(CAST(CustomerSatisfaction AS DECIMAL(5,2))) AS DECIMAL(5,2)) AS AvgRating, 
    MIN(CustomerSatisfaction) AS MinRating, 
    MAX(CustomerSatisfaction) AS MaxRating
FROM dbo.LogisticsDataset
GROUP BY DriverID
ORDER BY AvgRating ASC;

--Which drivers have the highest refused shipment rates?--
SELECT 
    DriverID,
    COUNT(*) AS TotalShipments,
    SUM(CASE WHEN ShipmentStatus = 'Refused' THEN 1 ELSE 0 END) AS RefusedLoads,
    CAST(100 * SUM(CASE WHEN ShipmentStatus = 'Refused' THEN 1 ELSE 0 END)
        / NULLIF(COUNT(*),0) AS DECIMAL(5,2)) AS RefusalRatePct
FROM dbo.LogisticsDataset
GROUP BY DriverID
ORDER BY RefusalRatePct DESC;

--Which drivers generate the lowest profit?--
SELECT
    DriverID,
    COUNT(*) AS TotalShipments, 
    CAST(SUM(Revenue - TotalCost - StorageCharges) / 1000 AS DECIMAL(10,2)) AS TotalProfitThous,
    CAST(AVG(Revenue - TotalCost - StorageCharges) AS DECIMAL(10,2)) AS AvgProfit
FROM dbo.LogisticsDataset
GROUP BY DriverID
ORDER BY TotalProfitThous ASC;

--To conclude, driver AKLG has a high percentage of missed appointments and redeliveries. Investigation should focus on--
--the specifics on the delays for this driver to identify if the issues are on the routes or operational exceptions.--
--Driver SEFT has high storage costs assocated with redeliveries, so the company needs to look into whether the costs---
--are related to the driver or other conditions to lower costs.--
--Driver TDYR should be a priority for investigating due to several areas of concern with lower customer satisfaction scores,--
--refused loads, and negative shipment profitability. Investigation needs to focus on identify opportunitities for improvement.--
--Driver MAXD has the lowest average profit of approximately negative $1,046 per shipment, which shows costs are--
--exceeding the shipments' revenue on average. Thus and investigation needs to be done to identify what exactly is--
--contributing to these losses.--

--Customer Satisfaction--
--What are the average customer scores?--
SELECT
    Customer, 
    COUNT(*) AS TotalRating,
    CAST(AVG(CAST(CustomerSatisfaction AS DECIMAL(10,2))) AS DECIMAL(10,2)) AS AvgRating
FROM dbo.LogisticsDataset
GROUP BY Customer
ORDER BY AvgRating DESC;
SELECT 
    Customer,
    CustomerSatisfaction,
    COUNT(*) As RatingTotals
FROM dbo.LogisticsDataset
GROUP BY Customer, CustomerSatisfaction
ORDER BY Customer, CustomerSatisfaction;

--What operational issues might be associated with low customer satisfaction?--
SELECT
    ExceptionType,
    COUNT(*) AS TotalIssues,
    CAST(AVG(CAST(CustomerSatisfaction AS DECIMAL(5,2))) AS DECIMAL(5,2)) AS AvgRating,
    MIN(CustomerSatisfaction) AS RatingMin,
    MAX(CustomerSatisfaction) AS RatingMAX
FROM dbo.LogisticsDataset
WHERE ExceptionType IS NOT NULL
GROUP BY ExceptionType
ORDER BY AvgRating DESC;
--Inlcude Null results too to avoid bias--
SELECT
    CASE WHEN ExceptionType IS NULL THEN 'No Exception' ELSE 'Has Exception' END AS ExceptionCategory,
    COUNT(*) AS TotalShipments,
    CAST(AVG(CAST(CustomerSatisfaction AS DECIMAL(5,2))) AS DECIMAL(5,2)) AS AvgRating
FROM dbo.LogisticsDataset
GROUP BY 
    CASE WHEN ExceptionType IS NULL THEN 'No Exception' ELSE 'Has Exception' END
ORDER BY AvgRating DESC;

--What is satisfaction score based on shipment status?--
SELECT
    ShipmentStatus,
    COUNT(*) AS TotalShipments,
    CAST(AVG(CAST(CustomerSatisfaction AS DECIMAL(5,2))) AS DECIMAL(5,2)) AS AvgRating
FROM dbo.LogisticsDataset
GROUP BY ShipmentStatus
ORDER BY AvgRating DESC

--What are the customer satisfaction on routes?--
SELECT
    OriginRamp,
    DestinationRamp,
    COUNT(*) AS TotalShipments,
    CAST(AVG(CAST(CustomerSatisfaction AS DECIMAL(5,2))) AS DECIMAL(5,2)) AS AvgRating
FROM dbo.LogisticsDataset
GROUP BY OriginRamp, DestinationRamp
ORDER BY AvgRating ASC;

